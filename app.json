{
  "expo": {
    "name": "Baby Care",
    "slug": "baby-tracker",
    "version": "1.6.1",
    "scheme": "babycare",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.babycare.app",
      "buildNumber": "10",
      "infoPlist": {
        "NSRemindersUsageDescription": "Allow Baby Care to set reminders for baby appointments.",
        "NSCalendarsUsageDescription": "Allow Baby Care to sync appointments with your calendar.",
        "NSPhotoLibraryUsageDescription": "Allow Baby Care to choose photos for your baby profile."
      }
    },
    "android": {
      "package": "com.babycare.app",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366F1",
          "sounds": [
            "./assets/sounds/alarm_digital.wav",
            "./assets/sounds/alarm_chime.wav",
            "./assets/sounds/alarm_bells.wav",
            "./assets/sounds/alarm_gentle.wav"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Baby Care to sync appointments with your device calendar."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Baby Care to select a profile photo for your baby."
        }
      ],
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "4a5c701e-98e2-4c09-b1f4-3b0a715ae277"
      }
    },
    "owner": "juanpanasiti"
  }
}